# ==============================================================================
# Students of Bihar (9-12) — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or any real credentials to Git.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser;
# all other variables are strictly server-only secrets.

# ------------------------------------------------------------------------------
# 1. Application Origin & Anti-Bot (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Exact public origin without trailing slash (used for strict CSRF Origin checks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile (invisible/managed bot defense for login & doubt posts)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Scoped Realtime
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY: Full DB access for API routes & scripts (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY: Supabase Project JWT Secret (used to sign scoped HS256 Realtime exam tokens)
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. Cryptographic Secrets (Generate each via: openssl rand -hex 32)
# ------------------------------------------------------------------------------
# 32+ byte hex secret for HMAC signing (e.g., scoped Realtime tokens & CSRF helpers)
SESSION_HMAC_SECRET=

# 32-byte (64 hex chars) AES-256-GCM key to encrypt cached OAuth tokens in DB
OAUTH_TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 4. Private Media Storage Vault (5 TB Google One via OAuth2 Refresh Token)
# ------------------------------------------------------------------------------
# SERVER-ONLY: Never exposed to browser clients
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ------------------------------------------------------------------------------
# 5. Editorial Question Structuring Pipeline (Super-Admin Private Only)
# ------------------------------------------------------------------------------
# SERVER-ONLY: Used strictly inside private Super-Admin review workflows
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Scheduled Maintenance (Vercel Cron)
# ------------------------------------------------------------------------------
# Bearer secret checked by /api/cron/media-gc (generate via: openssl rand -hex 32)
CRON_SECRET=

# ------------------------------------------------------------------------------
# 7. Local CLI-Only Migration Runner (NEVER add to Vercel)
# ------------------------------------------------------------------------------
# Mode A (Preferred — HTTPS via Supabase Management API):
# Generate a Personal Access Token at https://supabase.com/dashboard/account/tokens
# Strictly local CLI-only for `node scripts/apply-migrations.mjs` — NEVER add to Vercel!
SUPABASE_ACCESS_TOKEN=

# Mode B (Optional Fallback — Direct PostgreSQL via `psql`):
# SUPABASE_DB_URL=
